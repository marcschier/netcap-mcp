<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>NetcapMcp</RootNamespace>
    <AssemblyName>NetcapMcp</AssemblyName>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <!-- CA1515: Model types listed below are intentionally public as
         they form the MCP tool input/output schema surface. -->
    <NoWarn>$(NoWarn);CA1515</NoWarn>
  </PropertyGroup>

  <PropertyGroup Label="Pack as dotnet tool">
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>netcap-mcp</ToolCommandName>
    <PackageId>NetcapMcp</PackageId>
    <Description>Model Context Protocol server that captures network traces (pcap, http) and returns them as pcap, pcapng, JSON, CSV or text.</Description>
    <PackageTags>mcp;model-context-protocol;pcap;pcapng;network;capture;dotnet-tool;sharppcap</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\artifacts</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="SharpPcap" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NetcapMcp.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>
</Project>
