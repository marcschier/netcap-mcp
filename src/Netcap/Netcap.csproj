<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Netcap</RootNamespace>
    <AssemblyName>Netcap</AssemblyName>
    <!-- CA1515: Model types listed below are intentionally public as
         they form the capture / MCP-tool input/output schema surface. -->
    <NoWarn>$(NoWarn);CA1515</NoWarn>
  </PropertyGroup>

  <PropertyGroup Label="Pack as NuGet library">
    <IsPackable>true</IsPackable>
    <PackageId>Netcap</PackageId>
    <Description>Network trace capture engine for pcap / passive HTTP sources, with pcap, pcapng, JSON, CSV and text formatters.</Description>
    <PackageTags>pcap;pcapng;network;capture;sharppcap;tracing</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\artifacts</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="ModelContextProtocol.Core" />
    <PackageReference Include="SharpPcap" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Netcap.Mcp" />
    <InternalsVisibleTo Include="Netcap.Tests" />
    <InternalsVisibleTo Include="Netcap.Mcp.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>
</Project>
