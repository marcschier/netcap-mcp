<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Netcap.Mcp</RootNamespace>
    <AssemblyName>Netcap.Mcp</AssemblyName>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <PropertyGroup Label="Pack as dotnet tool">
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>netcap-mcp</ToolCommandName>
    <PackageId>Netcap.Mcp</PackageId>
    <Description>Model Context Protocol server that captures network traces (pcap, http) and returns them as pcap, pcapng, JSON, CSV or text.</Description>
    <PackageTags>mcp;model-context-protocol;pcap;pcapng;network;capture;dotnet-tool;sharppcap</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\artifacts</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Netcap\Netcap.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Netcap.Mcp.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>
</Project>
